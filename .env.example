# Jen lokální vývoj. Prázdné hodnoty vygeneruje make env uvnitř Dockeru.
PGUSER=jrc
PGDATABASE=jrc
PGPASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
JRC_BB_SECRET_KEY=
JRC_BB_ENCRYPTION_KEY_SALT=
S3_BUCKET=jrc-local
JRC_UID=
JRC_GID=
JRC_APP_PORT=13000
JRC_S3_PORT=13900
# FreeFrame: samostatná tajemství; web i API používají JRC_APP_PORT.
JRC_FF_JWT_SECRET=
JRC_FF_SYNC_PASSWORD=
# Sdílený klíč vstupenek Brightbean → FreeFrame (F5-B02).
JRC_FF_SSO_SECRET=
JRC_FF_S3_ACCESS_KEY=
JRC_FF_S3_SECRET_KEY=
JRC_FF_SYNC_EMAIL=jrc-sync@example.com
# Brightbean: vlastní S3 klíč jen pro bucket jrc-app (F2-B05).
JRC_BB_S3_ACCESS_KEY=
JRC_BB_S3_SECRET_KEY=
# Tvrdé stropy bucketů Garage (F2-B05); jednotky MiB/GiB.
JRC_S3_APP_QUOTA=20GiB
JRC_S3_VIDEO_QUOTA=100GiB
