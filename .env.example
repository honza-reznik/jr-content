# Místní prostředí a příprava vystavení. Prázdné hodnoty vygeneruje make env uvnitř Dockeru.
PGUSER=jrc
PGDATABASE=jrc
PGPASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
JRC_BB_SECRET_KEY=
JRC_BB_ENCRYPTION_KEY_SALT=
S3_BUCKET=jrc-local
JRC_UID=
JRC_GID=
JRC_APP_PORT=13000
JRC_POSTGRES_PORT=
JRC_S3_PORT=13900
JRC_BB_PORT=
# FreeFrame: samostatná tajemství; web i API používají JRC_APP_PORT.
JRC_FF_JWT_SECRET=
JRC_FF_SYNC_PASSWORD=
# Sdílený klíč vstupenek Brightbean → FreeFrame (F5-B02).
JRC_FF_SSO_SECRET=
JRC_FF_S3_ACCESS_KEY=
JRC_FF_S3_SECRET_KEY=
JRC_FF_SYNC_EMAIL=jrc-sync@example.com
# Brightbean: vlastní S3 klíč jen pro bucket jrc-app (F2-B05).
JRC_BB_S3_ACCESS_KEY=
JRC_BB_S3_SECRET_KEY=
# Tvrdé stropy bucketů Garage (F2-B05); jednotky MiB/GiB.
JRC_S3_APP_QUOTA=20GiB
JRC_S3_VIDEO_QUOTA=100GiB
# FreeFrame: stropy pro současně rozpracované nahrávání.
JRC_FF_MAX_CONCURRENT_UPLOADS_PER_USER=3
JRC_FF_MAX_PENDING_UPLOAD_BYTES_PER_PROJECT=21474836480

# P1-B04: šifrované databázové zálohy mimo Jarvis.
JRC_BACKUP_AGE_RECIPIENT=
JRC_BACKUP_GIT_DIR=/home/honza/jr-content-backup-git
JRC_BACKUP_GIT_REMOTE=
JRC_BACKUP_KEEP_OFFSITE=14

# P1-B01: prod = gunicorn + next start; dev = vývojové servery.
JRC_MODE=prod
# Bez koncové lomítkové cesty. Při prvním make env se odvodí z JRC_APP_PORT.
JRC_PUBLIC_ORIGIN=http://127.0.0.1:13000
# Prázdná hodnota je platná: aplikace v kořeni domény.
JRC_BASE_PATH=/jrc
# Volitelné SMTP pro Brightbean (TLS na 465, jinak STARTTLS). Prázdné = konzolový výstup.
JRC_SMTP_HOST=
JRC_SMTP_PORT=
JRC_SMTP_USER=
JRC_SMTP_PASSWORD=
JRC_SMTP_FROM=
