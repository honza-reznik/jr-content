{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	# Query credentials are needed by local HLS/SSE clients, but never by
	# access-log readers. Keep access logs useful while removing those values.
	log {
		format filter {
			wrap console
			fields {
				request>uri query {
					delete token
					delete ticket
					delete signature
					delete sig
					delete X-Amz-Signature
					delete X-Amz-Credential
					delete X-Amz-Security-Token
					delete X-Goog-Signature
				}
			}
		}
	}
	# Bezpečnostní hlavičky pro všechny odpovědi; defer přepíše hodnotu aplikace.
	header {
		defer
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
	# API předponu odstraníme, Next.js naopak potřebuje celý basePath.
	redir /video-api /video-api/ 308
	handle_path /video-api/* {
		# Správa FreeFrame (/admin) je jen vnitřní, přes společný vstup ne.
		@admin path /admin /admin/*
		respond @admin 403
		# API ověřuje Bearer token; cookies Brightbean ani webu mu nepředáváme.
		# Omezení počtu požadavků počítá podle X-Real-IP; hodnotu od klienta přepíšeme.
		reverse_proxy jrc-ff-api:8000 {
			header_up -Cookie
			header_up X-Real-IP {remote_host}
		}
	}
	@video path /video /video/*
	handle @video {
		# Přehrávač se vkládá do Brightbean na stejné adrese, jinam ne.
		# F2-B05: vynucená CSP; úložiště jen přesný původ místní brány S3 (náhledy,
		# segmenty HLS, nahrávání částí). Vývojový Next.js potřebuje inline a eval skripty.
		header {
			defer
			X-Frame-Options SAMEORIGIN
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:{$JRC_S3_PORT}; media-src 'self' blob: http://127.0.0.1:{$JRC_S3_PORT}; connect-src 'self' http://127.0.0.1:{$JRC_S3_PORT}; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		}
		reverse_proxy jrc-ff-web:3000
	}
	# Host včetně portu zachová kontrolu CSRF i odkazy společného vstupu.
	handle {
		header {
			defer
			X-Frame-Options DENY
		}
		reverse_proxy jrc-bb-web:8000
	}
}
