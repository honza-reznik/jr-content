{
	admin off
	servers {
		trusted_proxies static {$JRC_HOST_GATEWAY}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
	auto_https off
	persist_config off
	# Provozní warningy (např. přerušené SSE) také nesmí zaznamenat přístupové údaje.
	log default {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					delete ticket
					delete signature
					delete sig
					delete X-Amz-Signature
					delete X-Amz-Credential
					delete X-Amz-Security-Token
					delete X-Goog-Signature
				}
				request>headers>Cookie delete
				resp_headers>Set-Cookie delete
				resp_headers>Location delete
			}
		}
	}
}

:8080 {
	# Query credentials are needed by local HLS/SSE clients, but never by
	# access-log readers. Keep access logs useful while removing those values.
	log {
		format filter {
			wrap console
			fields {
				request>uri query {
					delete token
					delete ticket
					delete signature
					delete sig
					delete X-Amz-Signature
					delete X-Amz-Credential
					delete X-Amz-Security-Token
					delete X-Goog-Signature
				}
				request>headers>Cookie delete
				resp_headers>Set-Cookie delete
				resp_headers>Location delete
			}
		}
	}
	# Bezpečnostní hlavičky pro všechny odpovědi; defer přepíše hodnotu aplikace.
	header {
		defer
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		{$JRC_HSTS_HEADER}
	}
	# Zdraví je vždy jen stav, žádné provozní podrobnosti.
	@outside not path {$JRC_BASE_PATH} {$JRC_BASE_PATH}/ {$JRC_BASE_PATH}/*
	respond @outside 404
	{$JRC_BASE_REDIRECT}

	# Podpis zahrnuje původní /bucket/key a Host. Odstraníme pouze transportní
	# předponu; Host odpovídá veřejnému původu podpisu, query se nemění. Bez cookies.
	handle_path {$JRC_BASE_PATH}/storage/* {
		header {
			defer
			Content-Security-Policy "sandbox; default-src 'none'"
			X-Frame-Options DENY
		}
		@forbidden not method GET HEAD PUT POST OPTIONS
		respond @forbidden 405
		reverse_proxy jrc-s3:3900 {
			header_up Host {$JRC_PUBLIC_HOST}
			header_up -Cookie
			header_up -Authorization
		}
	}
	redir {$JRC_BASE_PATH}/video-api {$JRC_BASE_PATH}/video-api/ 308
	handle_path {$JRC_BASE_PATH}/video-api/* {
		@private path /admin /admin/* /docs /docs/* /redoc /openapi.json /setup /setup/*
		# Next middleware čte pouze boolean, nemůže založit správce.
		@setupStatus path /setup/status
		handle @setupStatus {
			reverse_proxy jrc-ff-api:8000 {
				header_up Host {$JRC_PUBLIC_HOST}
				header_up -Cookie
				header_up X-Real-IP {client_ip}
			}
		}
		handle @private {
			respond 404
		}
		handle {
			reverse_proxy jrc-ff-api:8000 {
				header_up Host {$JRC_PUBLIC_HOST}
				header_up Cookie "ff_hls={http.request.cookie.ff_hls}"
				header_up X-Real-IP {client_ip}
			}
		}
	}
	@video path {$JRC_BASE_PATH}/video {$JRC_BASE_PATH}/video/*
	handle @video {
		@setup path {$JRC_BASE_PATH}/video/setup {$JRC_BASE_PATH}/video/setup/*
		respond @setup 404
		header {
			defer
			X-Frame-Options SAMEORIGIN
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'{$JRC_SCRIPT_EVAL}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		}
		reverse_proxy jrc-ff-web:3000 {
			header_up Host {$JRC_PUBLIC_HOST}
		}
	}
	handle_path {$JRC_BASE_PATH}/* {
		@admin path /admin /admin/*
		respond @admin 404
		header {
			defer
			X-Frame-Options DENY
		}
		reverse_proxy jrc-bb-web:8000 {
			header_up Host {$JRC_PUBLIC_HOST}
			header_up X-Real-IP {client_ip}
		}
	}
}
